---
import PHDSIndex from '../../components/PHDSIndex.astro';
import '../../styles/global.css';
import SystemHeader from '../../components/SystemHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Gather PHDS entries from all systems
const entries = [
  // ── Stanton ──────────────────────────────────────────────────────────
  {
    href: `${base}stanton/phds/locations/daymar-biodome/`,
    name: 'Daymar Bio-Dome Remnants',
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Daymar',
    type: 'easter-egg',
    difficulty: 'Moderate',
    teaser: 'Three interconnected glass domes rising from Daymar\'s regolith — a covert research installation abandoned under mysterious circumstances.',
    heroImage: '/images/daymar/canyon-mapping.webp',
  },
  {
    href: `${base}stanton/phds/locations/orison-catwalks/`,
    name: "Orison's Secret Cloud-Layer Catwalks",
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Orison',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Transcom Science platform\'s maintenance catwalks, floating in a cloud-layer 75 m above the station — a hidden corridor for quiet urban photography.',
    heroImage: '/images/crusader/orison-city.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/yela-cryo-asteroid/`,
    name: "Yela's Cryo-Asteroid Formations",
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Yela Belt',
    type: 'photo-spot',
    difficulty: 'Moderate',
    teaser: 'Ice-crystal asteroids spinning in the silent dark of the Yela Belt — a serene quarry of slow-motion shots.',
    heroImage: '/images/yela/crystal-cave.webp',
  },
  {
    href: `${base}stanton/phds/locations/area18-tram-vistas/`,
    name: 'Area18 Transit Tram Vistas',
    system: 'Stanton',
    planet: 'ArcCorp',
    region: 'Area18',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Commuter trams threading through ArcCorp\'s urban labyrinth — motion-blur cityscapes and neon-lit architectural lines, accessible to anyone with a transit pass.',
    heroImage: '/images/arccorp/area18-aerial.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/port-tressler-under-hangar/`,
    name: "Port Tressler's Under-Hangar Vistas",
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'Port Tressler',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Maintenance catwalks beneath the main hangar — elevated vantage points over the frozen tarmac that most visitors walk right past.',
    heroImage: '/images/port-tressler/main-concourse.webp',
  },
  {
    href: `${base}stanton/phds/locations/microtech-ice-caves/`,
    name: 'Northern Wastes Ice Cave Complex',
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'Northern Wastes',
    type: 'natural-wonder',
    difficulty: 'Moderate',
    teaser: 'A network of subglacial ice caves northeast of The River — bioluminescent fungi and translucent blue walls waiting to be explored.',
    heroImage: '/images/microtech/bioluminescent-cave.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/new-babbage-ice/`,
    name: 'New Babbage Frozen Canal Ice Walls',
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'New Babbage',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Frozen canals outside New Babbage tram station I — towering ice walls with geometric fracture patterns, accessible on foot from the station.',
    heroImage: '/images/microtech/ice-arch.jpeg',
  },
  // ── Pyro ─────────────────────────────────────────────────────────────
  {
    href: `${base}stanton/phds/locations/pyro-vi-crashed-constellation/`,
    name: 'Terminus Crashed Constellation Phoenix',
    system: 'Pyro',
    planet: 'Terminus',
    region: 'Frozen Surface',
    type: 'easter-egg',
    difficulty: 'Hard',
    teaser: 'An RSI luxury touring ship — worth nearly 10 million credits — lying in pieces on a frozen methane surface. The community calls it "the Phoenix."',
    heroImage: '/images/pyro/pyro-6-mining.webp',
  },
  {
    href: `${base}pyro/phds/locations/pyro1-crashed-vanguard/`,
    name: 'Pyro I Crashed Vanguard Wreck',
    system: 'Pyro',
    planet: 'Pyro I',
    region: 'Equator Canyon',
    type: 'easter-egg',
    difficulty: 'Moderate',
    teaser: 'A Vanguard Harbinger fighter-bomber wedged in an equatorial canyon on the scorched surface of Pyro I — its bomb bay still open, still waiting.',
    heroImage: '/images/pyro/pyro-1-lava.webp',
  },
];

// Get visited/bookmarked state from props (will be empty on first render)
const visitedEntries = entries.map(entry => ({
  ...entry,
  visited: false,
  bookmarked: false,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hidden Discoveries — Lonely Planet Star Citizen</title>
  </head>
  <body>
    <SystemHeader
      system="System-wide"
      planet=""
      region=""
      title="Hidden Discoveries"
      type="easter-egg"
    />

    <div class="container mx-auto px-6 py-10">
      <div class="phds-page">
        <header class="phds-page__header">
          <h1 class="phds-page__title">Hidden Discoveries</h1>
          <p class="phds-page__subtitle">Locations not on the in-game map. Places the universe forgot — or never wanted you to find.</p>
        </header>

        <PHDSIndex entries={visitedEntries} />
      </div>
    </div>
  </body>
</html>

<style>
  .phds-page {
    max-width: 1200px;
    margin: 0 auto;
  }

  .phds-page__header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-primary-600);
  }

  .phds-page__title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin: 0 0 0.5rem;
    line-height: var(--line-height-tight);
  }

  .phds-page__subtitle {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin: 0;
    font-style: italic;
  }
</style>
