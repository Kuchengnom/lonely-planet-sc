---
import PHDSIndex from '../../components/PHDSIndex.astro'
import '../../styles/global.css';
import SystemHeader from '../../components/SystemHeader.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Gather PHDS entries from all systems
const entries = [
  // ── Stanton ──────────────────────────────────────────────────────────
  {
    href: `${base}stanton/phds/locations/daymar-biodome/`,
    name: 'Daymar Bio-Dome Remnants',
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Daymar',
    type: 'easter-egg',
    difficulty: 'Moderate',
    teaser: 'Three interconnected glass domes rising from Daymar\'s regolith — a covert research installation abandoned under mysterious circumstances.',
    heroImage: '/images/daymar/canyon-mapping.webp',
  },
  {
    href: `${base}stanton/phds/locations/orison-catwalks/`,
    name: "Orison's Secret Cloud-Layer Catwalks",
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Orison',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Transcom Science platform\'s maintenance catwalks, floating in a cloud-layer 75 m above the station — a hidden corridor for quiet urban photography.',
    heroImage: '/images/crusader/orison-city.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/yela-cryo-asteroid/`,
    name: "Yela's Cryo-Asteroid Formations",
    system: 'Stanton',
    planet: 'Crusader',
    region: 'Yela Belt',
    type: 'photo-spot',
    difficulty: 'Moderate',
    teaser: 'Ice-crystal asteroids spinning in the silent dark of the Yela Belt — a serene quarry of slow-motion shots.',
    heroImage: '/images/yela/crystal-cave.webp',
  },
  {
    href: `${base}stanton/phds/locations/area18-tram-vistas/`,
    name: 'Area18 Transit Tram Vistas',
    system: 'Stanton',
    planet: 'ArcCorp',
    region: 'Area18',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Commuter trams threading through ArcCorp\'s urban labyrinth — motion-blur cityscapes and neon-lit architectural lines, accessible to anyone with a transit pass.',
    heroImage: '/images/arccorp/area18-aerial.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/port-tressler-under-hangar/`,
    name: "Port Tressler's Under-Hangar Vistas",
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'Port Tressler',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Maintenance catwalks beneath the main hangar — elevated vantage points over the frozen tarmac that most visitors walk right past.',
    heroImage: '/images/port-tressler/main-concourse.webp',
  },
  {
    href: `${base}stanton/phds/locations/microtech-ice-caves/`,
    name: 'Northern Wastes Ice Cave Complex',
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'Northern Wastes',
    type: 'natural-wonder',
    difficulty: 'Moderate',
    teaser: 'A network of subglacial ice caves northeast of The River — bioluminescent fungi and translucent blue walls waiting to be explored.',
    heroImage: '/images/microtech/bioluminescent-cave.jpeg',
  },
  {
    href: `${base}stanton/phds/locations/new-babbage-ice/`,
    name: 'New Babbage Frozen Canal Ice Walls',
    system: 'Stanton',
    planet: 'MicroTech',
    region: 'New Babbage',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Frozen canals outside New Babbage tram station I — towering ice walls with geometric fracture patterns, accessible on foot from the station.',
    heroImage: '/images/microtech/ice-arch.jpeg',
  },
  // ── Pyro ─────────────────────────────────────────────────────────────
  {
    href: `${base}stanton/phds/locations/pyro-vi-crashed-constellation/`,
    name: 'Terminus Crashed Constellation Phoenix',
    system: 'Pyro',
    planet: 'Terminus',
    region: 'Frozen Surface',
    type: 'easter-egg',
    difficulty: 'Hard',
    teaser: 'An RSI luxury touring ship — worth nearly 10 million credits — lying in pieces on a frozen methane surface. The community calls it "the Phoenix."',
    heroImage: '/images/pyro/pyro-6-mining.webp',
  },
  {
    href: `${base}pyro/phds/locations/pyro1-crashed-vanguard/`,
    name: 'Pyro I Crashed Vanguard Wreck',
    system: 'Pyro',
    planet: 'Pyro I',
    region: 'Equator Canyon',
    type: 'easter-egg',
    difficulty: 'Moderate',
    teaser: 'A Vanguard Harbinger fighter-bomber wedged in an equatorial canyon on the scorched surface of Pyro I — its bomb bay still open, still waiting.',
    heroImage: '/images/pyro/pyro-1-lava.webp',
  },
  {
    href: `${base}arccorp/phds/locations/wala-moon-surface/`,
    name: 'Wala Moon — Deformed Surface',
    system: 'Stanton',
    planet: 'ArcCorp',
    region: 'Wala Orbit',
    type: 'anomaly',
    difficulty: 'Hard',
    teaser: 'A misshapen moon being slowly crushed by ArcCorp\'s gravity — elongated mountains, floating debris at the tidal equator, and gravity that shifts direction every 18 hours.',
    heroImage: '/images/arccorp/wala-surface.jpeg',
  },
  {
    href: `${base}pyro/phds/locations/bloom-abandoned-mining/`,
    name: 'Bloom Abandoned Mining Sites',
    system: 'Pyro',
    planet: 'Bloom (Pyro III)',
    region: 'Surface — multiple locations',
    type: 'abandoned-site',
    difficulty: 'Moderate to Extreme',
    teaser: 'The ruins of Pyrotechnic Amalgamated\'s mining empire on Bloom — silent, decaying, slowly being reclaimed by frozen soil. Prospect Depot, Bueno Ravine, and Carver\'s Ridge each offer unique industrial decay.',
    heroImage: '/images/pyro/pyro-3-wastes.webp',
  },
  {
    href: `${base}pyro/phds/locations/frozen-city-ruins/`,
    name: 'The Frozen City',
    system: 'Pyro',
    planet: 'Pyro V',
    region: 'Polar Plateau',
    type: 'mystery',
    difficulty: 'Extreme',
    teaser: 'A city carved entirely from ice, with no known origin, no records of construction, and mathematical patterns on its central sculpture. The most mysterious structure in the Stanton system.',
    heroImage: '/images/pyro/frozen-city-aerial.jpeg.webp',
  },
  {
    href: `${base}pyro/phds/locations/pyro-i-distortion-storm-edge/`,
    name: 'Pyro I Distortion Storm Edge',
    system: 'Pyro',
    planet: 'Pyro I',
    region: 'Lagrangian Point Observations',
    type: 'natural-wonder',
    difficulty: 'Extreme',
    teaser: 'Two violent distortion storms churning in a planet\'s atmosphere at temperatures that shouldn\'t support atmospheric physics — apocalyptic, awe-inspiring, and lethal from L-point observation.',
    heroImage: '/images/pyro/pyro-1-lava.webp',
  },
  {
    href: `${base}pyro/phds/locations/ruin-station-observation/`,
    name: 'Ruin Station Orbital Observation Post',
    system: 'Pyro',
    planet: 'Terminus (Pyro VI)',
    region: 'Orbit',
    type: 'observation-point',
    difficulty: 'Extreme',
    teaser: 'A sprawling mess of hulls and modules bolted together over five centuries — the observation points offer a vantage point no other place in the verse can match.',
    heroImage: '/images/pyro/ruin-station-lookout.webp',
  },
  {
    href: `${base}pyro/phds/locations/sacrens-plot/`,
    name: "Sacren's Plot",
    system: 'Pyro',
    planet: 'Pyro IV',
    region: 'Northern Highlands — Canyon Outpost',
    type: 'urban-sight',
    difficulty: 'Hard',
    teaser: 'A fortified outpost cut into a red rock canyon on Pyro IV, held by Citizens for Prosperity. Guards, turrets and missiles guard the approach — but inside the wire there is a working market.',
    heroImage: '/images/pyro/from-verseguide/sacrens-plot.jpg.webp',
  },
  {
    href: `${base}arccorp/phds/locations/the-underground/`,
    name: 'The Underground — ArcCorp\'s Hidden City',
    system: 'Stanton',
    planet: 'ArcCorp',
    region: 'Area18 Subsurface',
    type: 'hidden-find',
    difficulty: 'Moderate',
    teaser: 'A vast subterranean network of tunnels, chambers, and marketplaces beneath Area18 — an autonomous city that ArcCorp does not acknowledge but cannot fully seal off.',
    heroImage: '',
  },
  {
    href: `${base}arccorp/phds/locations/vault-7/`,
    name: 'ArcCorp Vault 7 — The Company\'s Safest Secret',
    system: 'Stanton',
    planet: 'ArcCorp',
    region: 'Area18 Subsurface, Deep Industrial Zone',
    type: 'mystery',
    difficulty: 'Extreme',
    teaser: 'ArcCorp\'s most secure storage facility, located hundreds of meters underground. Forty years old, never breached, and the single most famous mystery in Stanton space.',
    heroImage: '',
  },
  // ── Nyx ───────────────────────────────────────────────────────────────
  {
    href: `${base}nyx/phds/locations/levski/`,
    name: 'Levski — The People\'s Alliance Settlement',
    system: 'Nyx',
    planet: 'Delamar',
    region: 'Glaciem Ring',
    type: 'urban-sight',
    difficulty: 'Moderate',
    teaser: 'The People\'s Alliance settlement carved into Delamar\'s interior — a settlement unlike any polished corporate landing zone, featuring the Grand Barter market, Conscientious Objects, Café Musain, and the Anthony Tanaka memorial.',
    heroImage: '/images/nyx/glaciem.webp',
  },
  {
    href: `${base}nyx/phds/locations/peoples-service-stations/`,
    name: 'People\'s Service Stations',
    system: 'Nyx',
    planet: 'System-wide',
    region: 'Standard spacelanes',
    type: 'photo-spot',
    difficulty: 'Easy',
    teaser: 'Alpha, Delta, Theta, and Lambda stations offering restocking, rearming, refuelling, and shopping in the standard spacelanes — a safe haven in a system where safe havens are scarce.',
    heroImage: '/images/nyx/in-space.webp',
  },
];

// Get visited/bookmarked state from props (will be empty on first render)
const visitedEntries = entries.map(entry => ({
  ...entry,
  visited: false,
  bookmarked: false,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>Hidden Discoveries — Lonely Planet Star Citizen</title>
  </head>
  <body>
    <SystemHeader
      system="System-wide"
      planet=""
      region=""
      title="Hidden Discoveries"
      type="easter-egg"
    />

    <div class="phds-page-shell">
      <div class="phds-page">
        <header class="phds-page__header">
          <h1 class="phds-page__title">Hidden Discoveries</h1>
          <p class="phds-page__subtitle">Locations not on the in-game map. Places the universe forgot — or never wanted you to find.</p>
        </header>

        <PHDSIndex entries={visitedEntries} />
      </div>
    </div>
  </body>
</html>

<style>
  .phds-page {
    max-width: 1440px;
    margin: 0 auto;
  }

  .phds-page-shell {
    width: min(100% - 2rem, 1440px);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
  }

  @media (max-width: 640px) {
    .phds-page-shell {
      width: min(100% - 1.5rem, 1440px);
      padding-top: 1.5rem;
    }
  }

  .phds-page__header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-primary-600);
  }

  .phds-page__title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin: 0 0 0.5rem;
    line-height: var(--line-height-tight);
  }

  .phds-page__subtitle {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin: 0;
    font-style: italic;
  }
</style>
