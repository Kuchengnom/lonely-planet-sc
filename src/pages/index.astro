    transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .edition-card__cta:hover { color: var(--color-primary-900); transform: translateX(2px); }
  .edition-card__cta--disabled { pointer-events: none; color: var(--color-neutral-400); border-color: var(--color-neutral-300); }

  /* ── Feature band ──────────────────────────────────── */
  .feature-band {
    background: var(--color-surface-paper);
    border-top: 1px solid var(--color-neutral-200);
    border-bottom: 1px solid var(--color-neutral-200);
    padding: var(--space-16) 0;
  }

  .feature-band__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  /* ── Feature band image wrapper ────────────────────── */
  .feature-band__img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .feature-band__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    transition: transform 0.3s ease, opacity 0.4s ease;
  }

  .feature-band__img-wrap:hover .feature-band__img {
    transform: scale(1.03);
  }

  /* ─── Blur-up skeleton ─── */
  .feature-band__skeleton {
    position: absolute;
    inset: 0;
    background: var(--color-neutral-600);
    filter: blur(12px);
    transform: scale(1.1);
    z-index: 1;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .feature-band__img--loading {
    opacity: 0;
  }

  .feature-band__img--hidden {
    display: none;
  }

  .feature-band__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-neutral-700), var(--color-neutral-800));
    border-radius: var(--radius-md);
    z-index: 0;
  }

  .feature-band__placeholder-icon {
    font-size: 3rem;
  }

  .feature-band__eyebrow {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary-600);
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .feature-band__eyebrow::before {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-primary-500);
    flex-shrink: 0;
  }

  .feature-band__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-neutral-900);
    margin: 0 0 var(--space-4);
  }

  .feature-band__body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-700);
    margin: 0 0 var(--space-6);
  }

  .feature-band__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--color-neutral-200);
    margin-bottom: var(--space-8);
  }

  .feature-stat {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    border-right: 1px solid var(--color-neutral-200);
  }
  .feature-stat:last-child { border-right: none; }

  .feature-stat__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--font-weight-extrabold);
    line-height: 1;
    color: var(--color-primary-600);
  }
  .feature-stat__label {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  /* ── POI grid ──────────────────────────────────────── */
  .poi-section { padding: var(--space-16) 0; }
  .poi-section .container { max-width: 1280px; }

  .poi-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, auto));
    gap: var(--space-5);
  }

  .poi-card {
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  /* The lead story and its two companions form an editorial spread at wide sizes. */
  .poi-card--lead {
    grid-column: span 7;
    grid-row: span 2;
  }
  .poi-card--supporting { grid-column: span 5; }
  .poi-card:not(.poi-card--lead):not(.poi-card--supporting) { grid-column: span 4; }

  .poi-card--lead .poi-card__img-btn {
    aspect-ratio: auto;
    flex: 1;
    min-height: 0;
  }
  .poi-card--lead .poi-card__body {
    padding: var(--space-5) var(--space-6) var(--space-6);
    gap: var(--space-3);
    flex: 0;
  }
  .poi-card--lead .poi-card__name { font-size: clamp(1.5rem, 2.2vw, 2.125rem); }
  .poi-card--lead .poi-card__desc { max-width: 56ch; font-size: 0.9375rem; }
  .poi-card:hover,
  .poi-card:has(.poi-card__img-btn:focus-visible),
  .poi-card:has(.poi-card__name:focus-visible) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .poi-card__img-btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    border: none;
    padding: 0;
    background: var(--color-neutral-900);
    cursor: zoom-in;
  }

  .poi-card__img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .poi-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out),
                opacity var(--duration-normal) var(--ease-out);
    z-index: 2;
  }

  .poi-card__img-btn:hover .poi-card__img,
  .poi-card__img-btn:focus-visible .poi-card__img {
    transform: scale(1.04);
    opacity: 0.88;
  }

  /* ─── Blur-up skeleton ─── */
  .poi-card__skeleton {
    position: absolute;
    inset: 0;
    background: var(--color-neutral-600);
    filter: blur(12px);
    transform: scale(1.1);
    z-index: 1;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .poi-card__img--loading {
    opacity: 0;
  }

  .poi-card__img--hidden {
    display: none;
  }

  .poi-card__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-neutral-700), var(--color-neutral-800));
    z-index: 0;
  }

  .poi-card__placeholder-icon {
    font-size: 2.5rem;
  }

  .poi-card__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,20,45,0.72) 0%, transparent 55%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    pointer-events: none;
  }

  .poi-card__num {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.7);
  }

  .poi-card__tag-badge {
    font-family: var(--font-display);
    font-size: 0.5rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-white);
    background: rgba(30,58,138,0.8);
    padding: 3px 7px;
    border-radius: var(--radius-sm);
  }

  .poi-card__zoom-hint {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-size: 1.25rem;
    color: rgba(255,255,255,0.55);
    line-height: 1;
    transition: color var(--duration-fast);
    pointer-events: none;
  }
  .poi-card__img-btn:hover .poi-card__zoom-hint,
  .poi-card__img-btn:focus-visible .poi-card__zoom-hint { color: rgba(255,255,255,0.9); }

  .poi-card__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .poi-card__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    color: var(--color-neutral-900);
    text-decoration: none;
  }
  .poi-card__name:hover { color: var(--color-primary-600); }

  .poi-card__desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-600);
    margin: 0;
    flex: 1;
  }
  .poi-card__planet {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-neutral-400);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-neutral-200);
  }

  /* ── Lightbox ──────────────────────────────────────── */
  .lightbox {
    border: none;
    border-radius: var(--radius-lg);
    padding: 0;
    background: var(--color-neutral-900);
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    width: 100%;
    box-shadow: var(--shadow-2xl);
  }
  .lightbox::backdrop {
    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(4px);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(255,255,255,0.12);
    border: none;
    color: var(--color-white);
    font-size: 1rem;
    width: 36px; height: 36px;
    border-radius: var(--radius-full);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background var(--duration-fast);
    z-index: 10;
  }
  .lightbox__close:hover { background: rgba(255,255,255,0.24); }

  .lightbox__figure { margin: 0; display: flex; flex-direction: column; }

  .lightbox__img {
    display: block;
    width: 100%;
    max-height: calc(90vh - 56px);
    object-fit: contain;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .lightbox__caption {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-neutral-400);
    padding: var(--space-3) var(--space-6);
    text-align: center;
  }

  /* ── Community manifesto ───────────────────────────── */
  .manifesto {
    background: var(--color-primary-900);
    padding: var(--space-16) var(--space-6);
    text-align: center;
  }
  .manifesto__inner {
    max-width: var(--container-md);
    margin: 0 auto;
  }
  .manifesto__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    color: var(--color-white);
    margin: 0 0 var(--space-4);
  }
  .manifesto__body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    color: rgba(255,255,255,0.65);
    margin: 0 0 var(--space-8);
  }

  /* ── Footer ────────────────────────────────────────── */
  .site-footer {
    background: var(--color-neutral-900);
    color: var(--color-neutral-400);
    padding: var(--space-16) 0 var(--space-8);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-10);
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--letter-spacing-tight);
    text-transform: uppercase;
    color: var(--color-white);
    margin: 0 0 var(--space-3);
  }

  .site-footer__blurb {
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: var(--line-height-relaxed);
    color: rgba(255,255,255,0.38);
    margin: 0;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 var(--space-3);
  }

  .footer-links {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-links a {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-neutral-400);
    text-decoration: none;
    transition: color var(--duration-fast);
  }
  .footer-links a:hover { color: var(--color-primary-300); }

  .site-footer__bottom {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255,255,255,0.08);
    font-family: var(--font-display);
    font-size: 0.625rem;
    color: rgba(255,255,255,0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ── Hero entrance animation ───────────────────────── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero__title   { animation: fade-up 0.6s 0.08s ease both; }
  .hero__lede    { animation: fade-up 0.6s 0.18s ease both; }
  .hero__ctas    { animation: fade-up 0.6s 0.28s ease both; }
  .hero__launchpad { animation: fade-up 0.72s 0.24s ease both; }

  /* ── Time planner ──────────────────────────────────── */
  .time-planner {
    background: var(--color-white);
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .time-planner__inner {
    max-width: 1120px;
  }

  .time-planner__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(var(--space-8), 8vw, var(--space-20));
    align-items: end;
    margin-bottom: var(--space-10);
  }

  .time-planner__intro h2 {
    color: var(--color-neutral-900);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: 0.98;
    margin: 0;
    max-width: 20ch;
  }

  .time-planner__intro p {
    color: var(--color-neutral-700);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--line-height-relaxed);
    margin: 0;
    max-width: 42ch;
  }

  .time-planner__choices {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .time-planner__input,
  .sr-only {
    block-size: 1px;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    inline-size: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
  }

  .time-planner__choice {
    align-items: center;
    background: transparent;
    border: 1px solid var(--color-neutral-400);
    color: var(--color-neutral-900);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    justify-content: center;
    letter-spacing: var(--letter-spacing-widest);
    line-height: 1;
    margin-right: var(--space-2);
    min-height: 58px;
    min-width: 10.5rem;
    padding: 0.875rem 1.25rem;
    text-transform: uppercase;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .time-planner__choice span {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    margin-right: 0.35rem;
  }

  .time-planner__choice:hover {
    border-color: var(--color-neutral-900);
    color: var(--color-primary-700);
  }

  .time-planner__input:focus-visible + .time-planner__choice {
    outline: 3px solid var(--color-primary-400);
    outline-offset: 3px;
  }

  .time-planner__input:checked + .time-planner__choice {
    background: var(--color-neutral-900);
    border-color: var(--color-neutral-900);
    color: var(--color-white);
  }

  .time-planner__results {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-neutral-900);
  }

  .time-planner__result {
    background: transparent;
    display: none;
    padding: clamp(2rem, 5vw, 4.5rem) 0 0;
  }

  #time-one:checked ~ .time-planner__results .time-planner__result--one,
  #time-two:checked ~ .time-planner__results .time-planner__result--two,
  #time-extended:checked ~ .time-planner__results .time-planner__result--extended {
    display: grid;
  }

  .time-planner__result--one,
  .time-planner__result--two {
    align-items: end;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .time-planner__duration {
    color: var(--color-neutral-600);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-widest);
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
  }

  .time-planner__result h3 {
    color: var(--color-neutral-900);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-snug);
    margin: 0 0 var(--space-3);
  }

  .time-planner__result > div > p:not(.time-planner__duration),
  .time-planner__extended-intro > p:not(.time-planner__duration) {
    color: var(--color-neutral-700);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    margin: 0;
    max-width: 62ch;
  }

  .time-planner__gear {
    font-size: 0.8125rem !important;
    margin-top: var(--space-4) !important;
  }

  .time-planner__result .btn {
    justify-content: center;
    min-height: 48px;
    text-align: center;
  }

  .time-planner__result--extended {
    gap: var(--space-6);
  }

  .time-planner__route-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .time-planner__route {
    border-top: 1px solid var(--color-neutral-300);
    display: flex;
    flex-direction: column;
    min-height: 13rem;
    padding: var(--space-5) 0 0;
  }

  .time-planner__route h4 {
    color: var(--color-neutral-900);
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  .time-planner__route p {
    color: var(--color-neutral-600);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--space-5);
  }

  .time-planner__route a {
    align-self: flex-start;
    color: var(--color-primary-700);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    margin-top: auto;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-transform: uppercase;
  }

  .time-planner__route a:hover { color: var(--color-primary-900); }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: none; }
    .hero__slide:not(:first-child) { display: none; }
    .hero__slide img { transform: none; transition: none; }
    .hero__motion-toggle { display: none; }
    .hero__title,
    .hero__lede,
    .hero__ctas,
    .hero__launchpad { animation: none; }
    .btn,
    .edition-card,
    .edition-card__cta,
    .poi-card,
    .poi-card__img,
    .time-planner__choice { transition: none; }
  }

  /* ── Responsive ────────────────────────────────────── */
  @media (max-width: 1024px) {
    .editions-grid { grid-template-columns: repeat(2, 1fr); }
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
    .poi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
