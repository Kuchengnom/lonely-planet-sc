---
import '../styles/global.css';

const base = import.meta.env.BASE_URL + (import.meta.env.BASE_URL.endsWith('/') ? '' : '/');

interface Edition {
  name: string;
  subtitle: string;
  tagline: string;
  status: 'available' | 'coming-soon';
  href: string;
  theme: 'stanton' | 'pyro' | 'castra' | 'nyx';
  cover?: string;
}

const EDITIONS: Edition[] = [
  {
    name: 'Stanton',
    subtitle: 'The Corporate Core',
    tagline: 'Four planets. Four corporations. One system where power is the currency.',
    status: 'available',
    href: `${base}stanton/`,
    theme: 'stanton',
    cover: `${base}images/microtech/panoramic-lake.jpeg`,
  },
  {
    name: 'Pyro',
    subtitle: 'The Unstable Frontier',
    tagline: 'Six planets of volatile hostility and a near-total absence of law.',
    status: 'available',
    href: `${base}pyro/`,
    theme: 'pyro',
    cover: `${base}images/pyro/pyro-1-lava.webp`,
  },
  {
    name: 'Nyx',
    subtitle: 'The Lawless Fringe',
    tagline: "Home of Delamar and Levski. The rebel answer to Pyro's chaos.",
    status: 'available',
    href: `${base}nyx/`,
    theme: 'nyx',
    cover: `${base}images/nyx/glaciem.webp`,
  },
  {
    name: 'Castra',
    subtitle: 'The Next System',
    tagline: 'A single-star system on the Nyx run. Coming after Nyx.',
    status: 'coming-soon',
    href: '#',
    theme: 'castra',
    cover: `${base}images/castra/castra.webp`,
  },
];

const HERO_ROUTES = EDITIONS.filter((edition) => edition.status === 'available');

const POIS = [
  { num: '01', name: 'The First River',      tag: 'Natural Wonder', desc: 'Open water on a permafrost world. The anomaly that has no satisfying explanation.',             planet: 'microTech · Stanton', href: `${base}stanton/microtech/`,                                        img: `${base}images/microtech/ships-on-lake.jpeg`,        alt: 'Ships parked at the edge of the first river lake basin' },
  { num: '02', name: 'Bioluminescent Caves', tag: 'Hidden Find',    desc: 'Blue-cyan ceilings that look like an inverted starfield. Not on any official map.',            planet: 'microTech · Stanton', href: `${base}stanton/microtech/`,                                        img: `${base}images/microtech/bioluminescent-cave.jpeg`,  alt: 'Bioluminescent cave ceiling covered in blue-cyan glowing organisms' },
  { num: '03', name: 'New Babbage Commons',  tag: 'Settlement',     desc: 'Corporate grandeur bordering on absurdist. The warmest welcome on the coldest planet.',        planet: 'microTech · Stanton', href: `${base}stanton/microtech/`,                                        img: `${base}images/microtech/flying-over-mountains.jpeg`, alt: 'Small ship approaching New Babbage over snowy mountain ranges' },
  { num: '04', name: 'The Canyon River',     tag: 'Natural Wonder', desc: 'Canyon walls and a colour palette that screenshots struggle to convey. Fly it slowly.',         planet: 'microTech · Stanton', href: `${base}stanton/microtech/northern-wastes/canyon-river`,           img: `${base}images/microtech/canyon-river-aerial.jpeg`,  alt: 'Aerial view of the canyon river winding through autumn forest' },
  { num: '05', name: 'Orison',               tag: 'Settlement',     desc: "A city built on platforms in the clouds of a gas giant. Nowhere else in the 'Verse like it.",  planet: 'Crusader · Stanton',  href: `${base}stanton/crusader/`,                                         img: `${base}images/crusader/orison-city.jpeg`,       alt: 'Orison, the city on cloud platforms above Crusader' },
  { num: '06', name: 'Frozen Lakes',         tag: 'Natural Wonder', desc: 'Arches and columns of compressed blue-white ice. Walk them carefully — the footing is uneven.', planet: 'microTech · Stanton', href: `${base}stanton/microtech/`,                                        img: `${base}images/microtech/ice-arch.jpeg`,             alt: 'Ice arch formation rising from a frozen lake on MicroTech' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>Lonely Planet: Star Citizen</title>
    <meta name="description" content="Unofficial travel guides to the Star Citizen universe. Curated attractions, hidden gems, and essential travel tips." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:ital,wght@0,400;0,500;0,700;1,400&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=JetBrains+Mono&display=swap" rel="stylesheet" />
  </head>

  <body>

    <!-- Top strip -->
    <div class="top-strip">
      All Star Citizen editions are <strong>completely free</strong> — community-written, forever open access
    </div>

    <!-- Sticky header -->
    <header class="site-header">
      <div class="site-header__inner">
        <nav class="site-header__nav-left">
          <a href="#editions">Editions</a>
          <a href="#attractions">Attractions</a>
          <a href={`${base}phds/`}>Hidden Discoveries</a>
          <a href="#about">About</a>
        </nav>

        <button
          class="mobile-nav__toggle"
          id="mobile-nav-toggle"
          type="button"
          aria-controls="mobile-nav"
          aria-expanded="false"
        >
          <span class="sr-only">Open navigation</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>

        <a href={base} class="site-header__logo">
          <img src={`${base}logo.svg`} alt="Lonely Planet" class="site-header__logo-img" />
          <span class="site-header__logo-sub">Star Citizen Edition</span>
        </a>

        <span class="mobile-nav__balance" aria-hidden="true"></span>

        <nav class="site-header__nav-right">
          <a href="https://github.com/Kuchengnom/lonely-planet-sc" target="_blank" rel="noopener">Contribute</a>
          <a href="https://robertsspaceindustries.com/" target="_blank" rel="noopener">Community</a>
        </nav>
      </div>

      <dialog class="mobile-nav" id="mobile-nav" aria-labelledby="mobile-nav-title">
        <div class="mobile-nav__topline">
          <h2 id="mobile-nav-title">Explore the 'Verse</h2>
          <button class="mobile-nav__close" id="mobile-nav-close" type="button">
            <span class="sr-only">Close navigation</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
        <nav class="mobile-nav__links" aria-label="Primary navigation">
          <a href="#editions">Editions</a>
          <a href="#attractions">Attractions</a>
          <a href={`${base}phds/`}>Hidden Discoveries</a>
          <a href="#about">About</a>
          <a href="https://github.com/Kuchengnom/lonely-planet-sc" target="_blank" rel="noopener">Contribute</a>
          <a href="https://robertsspaceindustries.com/" target="_blank" rel="noopener">Community</a>
        </nav>
      </dialog>
    </header>

    <!-- Hero -->
    <header class="hero" style={`background-image: url(${base}images/microtech/panoramic-lake.jpeg)`}>
      <div class="hero__slideshow" data-hero-slideshow aria-hidden="true">
        <figure class="hero__slide is-active">
          <img src={`${base}images/microtech/panoramic-lake.jpeg`} alt="" fetchpriority="high" decoding="async" />
        </figure>
        <figure class="hero__slide">
          <img src={`${base}images/crusader/orison-city.jpeg`} alt="" loading="eager" decoding="async" />
        </figure>
        <figure class="hero__slide">
          <img src={`${base}images/pyro/pyro-1-lava.webp`} alt="" loading="eager" decoding="async" />
        </figure>
        <figure class="hero__slide">
          <img src={`${base}images/arccorp/area18-aerial.jpeg`} alt="" loading="eager" decoding="async" />
        </figure>
      </div>
      <button class="hero__motion-toggle" type="button" data-hero-motion-toggle aria-pressed="false">Pause scenery</button>
      <div class="hero__content">
        <div class="hero__inner">
          <h1 class="hero__title">Find your<br />next<br /><em>landing.</em></h1>
          <p class="hero__lede">
            Free, curated travel guides to the places in Star Citizen worth landing for.
            Choose a system, then follow a route that fits the time you have.
          </p>
          <div class="hero__ctas">
            <a href="#launchpad" class="btn btn--primary">Choose a system <span aria-hidden="true">→</span></a>
            <a href="#attractions" class="btn btn--ghost">See top sights</a>
          </div>
        </div>
        <nav class="hero__launchpad" id="launchpad" aria-labelledby="launchpad-heading">
          <h2 id="launchpad-heading">Choose your first system</h2>
          <div class="hero__routes">
            {HERO_ROUTES.map((edition) => (
              <a
                class={`hero__route hero__route--${edition.theme}`}
                href={edition.href}
                data-hero-slide={edition.theme === 'stanton' ? '0' : edition.theme === 'pyro' ? '2' : undefined}
              >
                <img src={edition.cover} alt="" loading="lazy" decoding="async" />
                <span class="hero__route-copy">
                  <strong>{edition.name}</strong>
                  <span>{edition.subtitle}</span>
                </span>
                <span class="hero__route-action" aria-hidden="true">Explore <span>→</span></span>
              </a>
            ))}
          </div>
        </nav>
      </div>
    </header>

    <main>

      <!-- Time planner: schedules are authored in the Hurston guide. -->
      <section class="time-planner" aria-labelledby="time-planner-heading">
        <div class="container time-planner__inner">
          <div class="time-planner__intro">
            <h2 id="time-planner-heading">How much time do you have for Hurston today?</h2>
            <p><strong>A Stanton sampler.</strong> Choose the time you actually have; the route below is a real, authored Hurston visit rather than a generated recommendation.</p>
          </div>

          <fieldset class="time-planner__choices">
            <legend class="sr-only">Choose your available time</legend>
            <input class="time-planner__input" type="radio" name="visit-time" id="time-one" checked aria-controls="time-one-result" />
            <label class="time-planner__choice" for="time-one"><span>1</span> hour</label>

            <input class="time-planner__input" type="radio" name="visit-time" id="time-two" aria-controls="time-two-result" />
            <label class="time-planner__choice" for="time-two"><span>2</span> hours</label>

            <input class="time-planner__input" type="radio" name="visit-time" id="time-extended" aria-controls="time-extended-result" />
            <label class="time-planner__choice" for="time-extended"><span>3–4</span> hours</label>

            <div class="time-planner__results">
              <article class="time-planner__result time-planner__result--one" id="time-one-result" aria-labelledby="time-one-title">
                <div>
                  <p class="time-planner__duration">1 hour · Hurston</p>
                  <h3 id="time-one-title">Lorville in an Hour</h3>
                  <p>A focused tour of Lorville’s essential landmarks: the Workers District, M&amp;V’s Bar, and the Central Tower.</p>
                  <p class="time-planner__gear"><strong>Bring:</strong> Filter mask, camera, and UEC for food.</p>
                </div>
                <a href={`${base}stanton/hurston/`} class="btn btn--primary">Open the Hurston itinerary <span aria-hidden="true">→</span></a>
              </article>

              <article class="time-planner__result time-planner__result--two" id="time-two-result" aria-labelledby="time-two-title">
                <div>
                  <p class="time-planner__duration">2 hours · Hurston</p>
                  <h3 id="time-two-title">Lorville Deep Dive</h3>
                  <p>Spend longer in the Workers District, walk the Strip Mine boundary, and venture into the Shanty Towns.</p>
                  <p class="time-planner__gear"><strong>Bring:</strong> Filter mask, camera with polarizing filter, water, and UEC for meals.</p>
                </div>
                <a href={`${base}stanton/hurston/`} class="btn btn--primary">Open the Hurston itinerary <span aria-hidden="true">→</span></a>
              </article>

              <section class="time-planner__result time-planner__result--extended" id="time-extended-result" aria-labelledby="time-extended-title">
                <div class="time-planner__extended-intro">
                  <p class="time-planner__duration">3–4 hours · Hurston</p>
                  <h3 id="time-extended-title">Choose your longer route</h3>
                  <p>Three authored itineraries fit this visit length. Pick the kind of day you want before opening the guide.</p>
                </div>
                <div class="time-planner__route-grid">
                  <article class="time-planner__route">
                    <h4>Extended Lorville Circuit</h4>
                    <p>Workers District, Strip Mines, Shanty Towns, and the Central Tower at sunset.</p>
                    <a href={`${base}stanton/hurston/`}>Open Hurston guide <span aria-hidden="true">→</span></a>
                  </article>
                  <article class="time-planner__route">
                    <h4>Moon Route: Aberdeen or Arial</h4>
                    <p>A quantum-capable ship route to one of Hurston’s moons.</p>
                    <a href={`${base}stanton/hurston/`}>Open Hurston guide <span aria-hidden="true">→</span></a>
                  </article>
                  <article class="time-planner__route">
                    <h4>Hurston City Hopper</h4>
                    <p>A circuit across Lorville, Aberdeen, and Arial.</p>
                    <a href={`${base}stanton/hurston/`}>Open Hurston guide <span aria-hidden="true">→</span></a>
                  </article>
                </div>
              </section>
            </div>
          </fieldset>
        </div>
      </section>

      <!-- System Editions -->
      <section class="editions" id="editions" aria-labelledby="editions-heading">
        <div class="container">
          <h2 id="editions-heading" class="section-heading">Every published edition</h2>

          <div class="editions-grid">
            {EDITIONS.map((ed) => (
              <article class={`edition-card edition-card--${ed.theme} ${ed.status === 'coming-soon' ? 'edition-card--soon' : ''}`}>
                <div class="edition-card__thumb">
                  {ed.cover
                    ? <img class="edition-card__cover" src={ed.cover} alt="" loading="lazy" />
                    : <div class="edition-card__planet" aria-hidden="true"></div>}
                  <div class="edition-card__overlay"></div>
                  <span class={`edition-card__status-badge ${ed.status === 'available' ? 'edition-card__status-badge--live' : ''}`}>
                    {ed.status === 'available' ? 'Available Now' : 'Coming Soon'}
                  </span>
                  <span class="edition-card__lp-badge">LP</span>
                  <div class="edition-card__thumb-text">
                    <span class="edition-card__eyebrow">Star Citizen</span>
                    <h3 class="edition-card__name">{ed.name}</h3>
                  </div>
                </div>
                <div class="edition-card__body">
                  <p class="edition-card__subtitle">{ed.subtitle}</p>
                  <p class="edition-card__tagline">{ed.tagline}</p>
                  {ed.status === 'available' ? (
                    <a href={ed.href} class="edition-card__cta">Explore →</a>
                  ) : (
                    <span class="edition-card__cta edition-card__cta--disabled">Coming soon</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Editor's Pick feature band -->
      <section class="feature-band">
        <div class="container feature-band__inner">
          <div class="feature-band__img-wrap">
            <div class="feature-band__skeleton" aria-hidden="true" />
            <img
              class="feature-band__img feature-band__img--loading"
              src={`${base}images/microtech/bioluminescent-cave.jpeg`}
              alt="Bioluminescent caves on microTech"
              loading="lazy"
              onload="this.classList.remove('feature-band__img--loading');this.previousElementSibling.style.display='none'"
              onerror="this.classList.add('feature-band__img--hidden');this.nextElementSibling.style.display='flex';this.previousElementSibling.style.display='none'"
            />
            <div class="feature-band__placeholder" aria-hidden="true">
              <span class="feature-band__placeholder-icon">🌌</span>
            </div>
          </div>
          <div class="feature-band__text">
            <p class="feature-band__eyebrow">Editor's Pick — Stanton IV</p>
            <h2 class="feature-band__heading">Seven reasons to land on microTech</h2>
            <p class="feature-band__body">
              Rivers that shouldn't exist, forests that refused to freeze, and caves that light
              up like an inverted starfield. The corporate ice world is the most quietly
              spectacular place in the Stanton system.
            </p>
            <div class="feature-band__stats">
              <div class="feature-stat">
                <span class="feature-stat__num">7</span>
                <span class="feature-stat__label">Attractions</span>
              </div>
              <div class="feature-stat">
                <span class="feature-stat__num">4</span>
                <span class="feature-stat__label">Hidden Finds</span>
              </div>
              <div class="feature-stat">
                <span class="feature-stat__num">1</span>
                <span class="feature-stat__label">City</span>
              </div>
            </div>
            <a href={`${base}stanton/microtech/`} class="btn btn--primary">Read the microTech Guide →</a>
          </div>
        </div>
      </section>

      <!-- Top Attractions -->
      <section class="poi-section" id="attractions" aria-labelledby="attractions-heading">
        <div class="container">
          <h2 id="attractions-heading" class="section-heading">Top Attractions</h2>
          <div class="poi-grid">
            {POIS.map((poi, index) => (
              <article class={`poi-card ${index === 0 ? 'poi-card--lead' : index === 1 || index === 2 ? 'poi-card--supporting' : ''}`}>
                <button
                  class="poi-card__img-btn"
                  data-img={poi.img}
                  data-alt={poi.alt}
                  data-name={poi.name}
                  aria-label={`View full image: ${poi.alt}`}
                >
                  <div class="poi-card__img-wrap">
                    <div class="poi-card__skeleton" aria-hidden="true" />
                    <img src={poi.img} alt={poi.alt} loading="lazy"
                         class="poi-card__img poi-card__img--loading"
                         onload="this.classList.remove('poi-card__img--loading');this.previousElementSibling.style.display='none'"
                         onerror="this.classList.add('poi-card__img--hidden');this.nextElementSibling.style.display='flex';this.previousElementSibling.style.display='none'" />
                    <div class="poi-card__placeholder" aria-hidden="true">
                      <span class="poi-card__placeholder-icon">🌌</span>
                    </div>
                  </div>
                  <div class="poi-card__img-overlay">
                    <span class="poi-card__num">{poi.num}</span>
                    <span class="poi-card__tag-badge">{poi.tag}</span>
                  </div>
                  <span class="poi-card__zoom-hint" aria-hidden="true">⊕</span>
                </button>
                <div class="poi-card__body">
                  <a href={poi.href} class="poi-card__name">{poi.name}</a>
                  <p class="poi-card__desc">{poi.desc}</p>
                  <span class="poi-card__planet">{poi.planet}</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Lightbox -->
      <dialog class="lightbox" id="lightbox" aria-modal="true" aria-label="Image viewer">
        <button class="lightbox__close" id="lightbox-close" aria-label="Close">✕</button>
        <figure class="lightbox__figure">
          <img class="lightbox__img" id="lightbox-img" src="" alt="" />
          <figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
        </figure>
      </dialog>

      <script>
        (() => {
          const slideshow = document.querySelector<HTMLElement>('[data-hero-slideshow]');
          const toggle = document.querySelector<HTMLButtonElement>('[data-hero-motion-toggle]');
          if (!slideshow || !toggle) return;

          const slides = Array.from(slideshow.querySelectorAll<HTMLElement>('.hero__slide'));
          const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
          let activeIndex = 0;
          let isInView = true;
          let isPaused = motionPreference.matches;
          let rotation: number | undefined;

          const setToggleLabel = () => {
            toggle.textContent = isPaused ? 'Play scenery' : 'Pause scenery';
            toggle.setAttribute('aria-pressed', String(isPaused));
          };
          const showNext = () => {
            slides[activeIndex]?.classList.remove('is-active');
            activeIndex = (activeIndex + 1) % slides.length;
            slides[activeIndex]?.classList.add('is-active');
          };
          const showSlide = (index: number) => {
            if (!Number.isInteger(index) || index < 0 || index >= slides.length || index === activeIndex) return;
            slides[activeIndex]?.classList.remove('is-active');
            activeIndex = index;
            slides[activeIndex]?.classList.add('is-active');
          };
          const syncRotation = () => {
            window.clearInterval(rotation);
            if (!isPaused && isInView) rotation = window.setInterval(showNext, 7000);
          };

          const visibilityObserver = new IntersectionObserver(([entry]) => {
            isInView = entry.isIntersecting;
            syncRotation();
          }, { threshold: 0.15 });
          visibilityObserver.observe(slideshow);

          toggle.addEventListener('click', () => {
            isPaused = !isPaused;
            setToggleLabel();
            syncRotation();
          });
          motionPreference.addEventListener('change', event => {
            isPaused = event.matches;
            setToggleLabel();
            syncRotation();
          });
          document.querySelectorAll<HTMLElement>('[data-hero-slide]').forEach(route => {
            const revealRouteScene = () => showSlide(Number(route.dataset.heroSlide));
            route.addEventListener('mouseenter', revealRouteScene);
            route.addEventListener('focus', revealRouteScene);
          });

          setToggleLabel();
          syncRotation();
        })();
      </script>

      <script>
        const dialog = document.getElementById('lightbox') as HTMLDialogElement;
        const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
        const lbCaption = document.getElementById('lightbox-caption') as HTMLElement;
        const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;

        document.querySelectorAll<HTMLButtonElement>('.poi-card__img-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            lbImg.src = btn.dataset.img ?? '';
            lbImg.alt = btn.dataset.alt ?? '';
            lbCaption.textContent = btn.dataset.name ?? '';
            dialog.showModal();
          });
        });

        closeBtn.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      </script>

      <script>
        (() => {
          const mobileMenu = document.getElementById('mobile-nav') as HTMLDialogElement | null;
          const mobileMenuToggle = document.getElementById('mobile-nav-toggle') as HTMLButtonElement | null;
          const mobileMenuClose = document.getElementById('mobile-nav-close') as HTMLButtonElement | null;
          if (!mobileMenu || !mobileMenuToggle || !mobileMenuClose) return;

          let restoreToggleFocus = true;
          const syncMenuState = () => {
            const isOpen = mobileMenu.open;
            mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
            document.body.classList.toggle('mobile-nav-open', isOpen);
          };
          const closeMobileMenu = (shouldRestoreFocus = true) => {
            restoreToggleFocus = shouldRestoreFocus;
            if (mobileMenu.open) mobileMenu.close();
          };

          mobileMenuToggle.addEventListener('click', () => {
            restoreToggleFocus = true;
            mobileMenu.showModal();
            syncMenuState();
            requestAnimationFrame(() => mobileMenuClose.focus());
          });
          mobileMenuClose.addEventListener('click', () => closeMobileMenu());
          mobileMenu.addEventListener('click', (event) => {
            if (event.target === mobileMenu) closeMobileMenu();
          });
          mobileMenu.addEventListener('close', () => {
            syncMenuState();
            if (restoreToggleFocus) mobileMenuToggle.focus();
            restoreToggleFocus = true;
          });
          mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => closeMobileMenu(false));
          });
          window.matchMedia('(min-width: 861px)').addEventListener('change', event => {
            if (event.matches) closeMobileMenu(false);
          });
        })();
      </script>

      <!-- Scroll spy: highlight active nav link as user scrolls -->
      <script>
        (() => {
          const navLinks = document.querySelectorAll('.site-header__nav-left a[href^="#"], .site-header__nav-right a[href^="#"], .mobile-nav__links a[href^="#"]');
          if (!navLinks.length) return;

          const anchors = Array.from(navLinks).map(link => {
            const href = link.getAttribute('href');
            if (!href || !href.startsWith('#')) return null;
            const target = document.getElementById(href.slice(1));
            if (!target) return null;
            return { link, target, href };
          }).filter(Boolean);

          if (!anchors.length) return;

          // Offset for sticky header — matches the CSS scroll-padding-top
          const headerHeight = 60; // site-header height
          const offset = Math.max(headerHeight + 24, parseInt(getComputedStyle(document.documentElement)
            .getPropertyValue('--scroll-anchor-offset') || '80'));

          const observerOptions = {
            root: null,
            rootMargin: `-${offset}px 0px -40% 0px`,
            threshold: 0,
          };

          const observer = new IntersectionObserver((entries) => {
            // entries are already sorted by depth (first appearing = most visible)
            const visible = entries.filter(e => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

            let activeAnchor = anchors[0];
            for (const entry of visible) {
              const candidate = anchors.find(a => a.target === entry.target);
              if (candidate) { activeAnchor = candidate; break; }
            }

            for (const a of anchors) {
              a.link.classList.toggle('is-active', a.href === activeAnchor.href);
            }
          }, observerOptions);

          for (const anchor of anchors) {
            observer.observe(anchor.target);
          }
        })();
      </script>

