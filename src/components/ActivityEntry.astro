---
interface Props {
  title: string
  category: 'mining' | 'hunting' | 'exploration' | 'mission'
  image: string
  imageAlt: string
}

const { title, category, image, imageAlt } = Astro.props

const categoryLabels = {
  'mining': '⛏️ Mining',
  'hunting': '🎯 Hunting',
  'exploration': '🔭 Exploration',
  'mission': '📋 Mission'
}

const categoryColors = {
  'mining': 'var(--color-secondary-600)',
  'hunting': 'var(--color-secondary-500)',
  'exploration': 'var(--color-primary-600)',
  'mission': 'var(--color-success)'
}

const categoryBackgrounds = {
  'mining': 'var(--color-secondary-50)',
  'hunting': 'var(--color-secondary-100)',
  'exploration': 'var(--color-primary-50)',
  'mission': 'var(--color-success)'
}
---

<section class="activity-entry">
  <span class="activity-badge" style={`color: ${categoryColors[category]}; background-color: ${categoryBackgrounds[category]}`}>
    {categoryLabels[category]}
  </span>
  <h3 class="activity-title">{title}</h3>
  <div class="activity-image">
    <div class="activity-image__skeleton" aria-hidden="true" />
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class="activity-image__img activity-image__img--loading"
      onload="this.classList.remove('activity-image__img--loading');this.previousElementSibling.style.display='none'"
      onerror="this.classList.add('activity-image__img--hidden');this.nextElementSibling.style.display='flex';this.previousElementSibling.style.display='none'"
    />
    <div class="activity-image__placeholder" aria-hidden="true">
      <span class="activity-image__placeholder-icon">🌌</span>
    </div>
  </div>
  <div class="activity-description">
    <slot />
  </div>
</section>

<style>
  .activity-entry {
    margin: var(--space-8) 0;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal) var(--ease-out), transform var(--duration-normal) var(--ease-out);
  }

  .activity-entry:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .activity-badge {
    font-size: var(--text-body-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    display: inline-block;
    font-family: var(--font-display);
  }

  .activity-title {
    font-size: var(--text-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-neutral-900);
    margin: var(--space-3) 0 var(--space-4) 0;
    font-family: var(--font-display);
  }

  .activity-image {
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    height: 12rem;
  }

  .activity-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.4s ease;
    position: relative;
    z-index: 2;
    display: block;
  }

  .activity-image:hover .activity-image__img {
    transform: scale(1.03);
  }

  /* ─── Blur-up skeleton ─── */
  .activity-image__skeleton {
    position: absolute;
    inset: 0;
    background: var(--color-neutral-600);
    filter: blur(12px);
    transform: scale(1.1);
    z-index: 1;
    transition: opacity 0.5s ease;
  }

  .activity-image__img--loading {
    opacity: 0;
  }

  .activity-image__img--hidden {
    display: none;
  }

  .activity-image__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-neutral-700), var(--color-neutral-800));
  }

  .activity-image__placeholder-icon {
    font-size: 2.5rem;
  }

  .activity-description {
    color: var(--color-neutral-700);
    line-height: var(--line-height-relaxed);
    font-family: var(--font-body);
    font-size: var(--text-body-md);
  }
</style>
