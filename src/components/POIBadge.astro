---
interface Props {
  type: 'natural-wonder' | 'easter-egg' | 'urban-sight' | 'technical' | 'photo-spot' | 'anomaly' | 'hidden-find' | 'mystery' | 'abandoned-site' | 'observation-point';
}

const { type } = Astro.props;

const BADGE_CONFIG = {
  'natural-wonder':    { label: 'Natural Wonder',    emoji: '🏔️', bg: 'var(--color-category-wonder)' },
  'easter-egg':        { label: 'Easter Egg',        emoji: '🎄', bg: 'var(--color-category-hidden)' },
  'urban-sight':       { label: 'Urban Sight',       emoji: '🏢', bg: 'var(--color-primary-600)' },
  'technical':         { label: 'Technical',         emoji: '🛸', bg: 'var(--color-difficulty-moderate)' },
  'photo-spot':        { label: 'Photo Spot',        emoji: '📸',  bg: '#db2777' },
  'anomaly':           { label: 'Anomaly',           emoji: '🌀', bg: '#0891b2' },
  'hidden-find':       { label: 'Hidden Find',       emoji: '🗝️', bg: '#059669' },
  'mystery':           { label: 'Mystery',           emoji: '🔮', bg: '#4f46e5' },
  'abandoned-site':    { label: 'Abandoned Site',    emoji: '🏚️', bg: '#6b7280' },
  'observation-point': { label: 'Observation Point', emoji: '🔭', bg: '#7c3aed' },
} as const;

const config = BADGE_CONFIG[type];
---

<span class="poi-badge" style={`background-color: ${config.bg};`}>
  {config.emoji} {config.label}
</span>

<style>
  .poi-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-body-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-white);
    white-space: nowrap;
  }
</style>
