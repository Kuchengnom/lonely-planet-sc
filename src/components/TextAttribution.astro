---
interface Props {
  dataType: 'coordinates' | 'navigation' | 'description'
  locationName?: string
  showIcon?: boolean
}

const { 
  dataType, 
  locationName,
  showIcon = true 
} = Astro.props

const dataTypes = {
  'coordinates': {
    label: 'Location Data',
    icon: '📍',
    tooltip: 'Coordinates provided by VerseGuide'
  },
  'navigation': {
    label: 'Route Information',
    icon: '🧭', 
    tooltip: 'Navigation data from VerseGuide'
  },
  'description': {
    label: 'Additional Details',
    icon: 'ℹ️',
    tooltip: 'Enhanced with VerseGuide content'
  }
}

const config = dataTypes[dataType]
---

<div class="text-attribution">
  <a 
    href="https://verseguide.com" 
    target="_blank" 
    rel="noopener noreferrer"
    class="text-attribution__link"
    title={config.tooltip}
  >
    {showIcon && <span class="text-attribution__icon" aria-hidden="true">{config.icon}</span>}
    <span class="text-attribution__text">
      {config.label} from <span class="text-attribution__source">VerseGuide</span>
    </span>
    <span class="text-attribution__arrow" aria-hidden="true">↗</span>
  </a>
</div>

<style>
  .text-attribution {
    display: inline;
    margin-left: var(--space-2);
  }

  .text-attribution__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-primary-600);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--text-body-xs);
    font-weight: var(--font-weight-medium);
    border-bottom: 1px dotted var(--color-primary-600);
    transition: all var(--duration-fast) var(--ease-out);
    opacity: 0.8;
  }

  .text-attribution__link:hover {
    color: var(--color-primary-700);
    opacity: 1;
    border-bottom-style: solid;
  }

  .text-attribution__icon {
    font-size: 0.9em;
    line-height: 1;
  }

  .text-attribution__text {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    line-height: 1.3;
  }

  .text-attribution__source {
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  .text-attribution__arrow {
    font-size: 0.85em;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .text-attribution__link:hover .text-attribution__arrow {
    transform: translate(1px, -1px);
  }

  /* Compact version for inline use */
  @media (max-width: 640px) {
    .text-attribution__link {
      font-size: 0.7rem;
      gap: 0.25rem;
    }

    .text-attribution__icon {
      display: none;
    }
  }
</style>
