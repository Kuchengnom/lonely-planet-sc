---
interface Props {
  title: string;
  duration: '1h' | '2h' | '3-4h';
  description?: string;
  required_gear: string[];
  moon_warning?: string;
  hopper_banner?: string;
}

const { title, duration, description, required_gear, moon_warning, hopper_banner } = Astro.props;

const LABELS = {
  '1h': '1 Hour',
  '2h': '2 Hours',
  '3-4h': '3–4 Hours',
};
---

<section class="tour-schedule" aria-label={`${title} — ${LABELS[duration]} tour`}>
  <header class="tour-header">
    <h2 class="tour-header__title">{title}</h2>
    {description && <p class="tour-header__desc">{description}</p>}
  </header>

  <div class="tour-equipment">
    <span class="tour-equipment__label">Required:</span>
    <ul class="tour-equipment__list">
      {required_gear.map(item => (
        <li class="tour-equipment__item">{item}</li>
      ))}
    </ul>
  </div>

  {moon_warning && (
    <div class="moon-warning">
      <span class="moon-warning__icon">⚠️</span>
      <span>{moon_warning}</span>
    </div>
  )}

  {hopper_banner && (
    <div class="hopper-banner">
      <span class="hopper-banner__icon">🏙</span>
      <span>{hopper_banner}</span>
    </div>
  )}

  <ol class="timeline">
    <slot />
  </ol>
</section>

<style>
  .tour-schedule {
    background: var(--color-surface-paper);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 1.75rem 2rem;
  }

  .tour-header__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin: 0 0 0.375rem;
    line-height: 1.3;
  }

  .tour-header__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  .tour-equipment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    background: var(--color-surface-cream);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .tour-equipment__label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    flex-shrink: 0;
  }

  .tour-equipment__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tour-equipment__item {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-neutral-800);
    background: white;
    border: 1px solid var(--color-neutral-300);
    border-radius: 0.25rem;
    padding: 0.2rem 0.6rem;
    line-height: 1.5;
  }

  /* Warning banners */
  .moon-warning {
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #92400e;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .moon-warning__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.5;
  }

  .hopper-banner {
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #0c4a6e;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .hopper-banner__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.5;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline > li {
    display: flex;
    gap: 1.25rem;
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .timeline__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 2rem;
  }

  .timeline__bullet {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-primary-600);
    border: 3px solid var(--color-surface-paper);
    box-shadow: 0 0 0 2px var(--color-primary-600);
    position: relative;
    z-index: 1;
  }

  .timeline__line {
    flex: 1;
    width: 2px;
    background: var(--color-neutral-300);
    margin-top: 0.5rem;
  }

  .timeline__content {
    flex: 1;
    min-width: 0;
  }

  .timeline__time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-600);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .timeline__stop {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .timeline__route {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-neutral-600);
    font-style: italic;
    margin-bottom: 0.375rem;
  }

  .timeline__gear {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .timeline__supplies {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    color: #065f46;
    background: #d1fae5;
    border: 1px solid #a7f3d0;
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .timeline__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-neutral-800);
    margin: 0;
  }

  @media (max-width: 640px) {
    .tour-schedule {
      padding: 1.25rem;
    }
    .timeline > li {
      gap: 0.75rem;
    }
    .timeline__marker {
      width: 1.5rem;
    }
  }
</style>
