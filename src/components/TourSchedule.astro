---
interface Props {
  title: string;
  duration: '1h' | '2h' | '3-4h';
  description?: string;
  required_gear: string[];
  moon_warning?: string;
  hopper_banner?: string;
}

const { title, duration, description, required_gear, moon_warning, hopper_banner } = Astro.props;

const LABELS = {
  '1h': '1 Hour',
  '2h': '2 Hours',
  '3-4h': '3–4 Hours',
};
---

<section class="tour-schedule" aria-label={`${title} — ${LABELS[duration]} tour`}>
  <header class="tour-header">
    <h2 class="tour-header__title">{title}</h2>
    {description && <p class="tour-header__desc">{description}</p>}
  </header>

  <div class="tour-equipment">
    <span class="tour-equipment__label-badge">Required</span>
    <ul class="tour-equipment__list">
      {required_gear.map(item => (
        <li class="tour-equipment__item">{item}</li>
      ))}
    </ul>
  </div>

  {moon_warning && (
    <div class="warning-banner warning-banner--warning">
      <span class="warning-banner__icon">⚠️</span>
      <span class="warning-banner__text">{moon_warning}</span>
    </div>
  )}

  {hopper_banner && (
    <div class="warning-banner warning-banner--hop">
      <span class="warning-banner__icon">🏙</span>
      <span class="warning-banner__text">{hopper_banner}</span>
    </div>
  )}

  <div class="step-cards">
    <slot />
  </div>
</section>

<style>
  /* ─── Container ─── */
  .tour-schedule {
    background: var(--color-surface-paper);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 1.75rem 2rem;
  }

  /* ─── Header ─── */
  .tour-header__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin: 0 0 0.375rem;
    line-height: 1.3;
  }

  .tour-header__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Equipment ─── */
  .tour-equipment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .tour-equipment__label-badge {
    display: inline-flex;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    border: 1px solid var(--color-primary-200);
    flex-shrink: 0;
  }

  .tour-equipment__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tour-equipment__item {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-neutral-800);
    background: white;
    border: 1px solid var(--color-neutral-300);
    border-radius: 0.25rem;
    padding: 0.2rem 0.6rem;
    line-height: 1.5;
  }

  /* ─── Warning Banners ─── */
  .warning-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .warning-banner__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.5;
  }

  .warning-banner__text {
    font-family: var(--font-body);
    line-height: 1.6;
  }

  .warning-banner--warning {
    background: #fef3c7;
    border: 1px solid #fde68a;
    color: #92400e;
  }

  .warning-banner--hop {
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    color: #0c4a6e;
  }

  /* ─── Step Cards ─── */
  .step-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Color cycling for step numbers via CSS */
  .step-cards > .step-card:nth-child(1) .step-card__number { background-color: var(--color-primary-600); }
  .step-cards > .step-card:nth-child(2) .step-card__number { background-color: var(--color-accent-emerald); }
  .step-cards > .step-card:nth-child(3) .step-card__number { background-color: var(--color-accent-terracotta); }
  .step-cards > .step-card:nth-child(4) .step-card__number { background-color: var(--color-accent-sand); }
  .step-cards > .step-card:nth-child(5) .step-card__number { background-color: var(--color-accent-lavender); }
  .step-cards > .step-card:nth-child(6) .step-card__number { background-color: var(--color-secondary-600); }
  .step-cards > .step-card:nth-child(7) .step-card__number { background-color: var(--color-accent-coral); }
  .step-cards > .step-card:nth-child(8) .step-card__number { background-color: var(--color-accent-sage); }

  /* ─── Number ring for each step ─── */
  .step-cards > .step-card .step-card__number {
    position: relative;
  }

  .step-cards > .step-card:nth-child(n+2) .step-card__number::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 0.75rem;
    background: var(--color-neutral-300);
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .tour-schedule {
      padding: 1.25rem;
    }

    .step-card__header {
      flex-wrap: wrap;
    }

    .step-card__number {
      width: 2.5rem;
      height: 2.5rem;
    }

    .step-card__number-text {
      font-size: 1.25rem;
    }

    .step-card__title {
      font-size: 1rem;
    }

    .step-card__time {
      font-size: 0.625rem;
      padding: 0.2rem 0.5rem;
    }
  }
</style>
