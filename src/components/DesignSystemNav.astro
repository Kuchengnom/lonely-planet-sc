---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<nav class="ds-nav" aria-label="Design system navigation">
  <div class="ds-nav__brand">Design System</div>
  <ul class="ds-nav__list">
    <li><a href={`${base}design-system/`} class="ds-nav__link">Overview</a></li>
    {sections.map((s) => (
      <li><a href={`#${s.id}`} class="ds-nav__link">{s.label}</a></li>
    ))}
  </ul>
</nav>