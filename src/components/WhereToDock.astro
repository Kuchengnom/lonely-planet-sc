---
interface Props {
  title: string
  category: 'landing-zone' | 'habitation' | 'rest-stop'
  image: string
  imageAlt: string
}

const { title, category, image, imageAlt } = Astro.props

const categoryLabels = {
  'landing-zone': '🛬 Landing Zone',
  'habitation': '🏠 Habitation',
  'rest-stop': '☕ Rest Stop'
}
---

<section class="docks-entry">
  <div class="docks-category-label">{categoryLabels[category]}</div>
  <h3 class="docks-title">{title}</h3>
  <div class="docks-image">
    <div class="docks-image__skeleton" aria-hidden="true" />
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class="docks-image__img docks-image__img--loading"
      onload="this.classList.remove('docks-image__img--loading');this.previousElementSibling.style.display='none'"
      onerror="this.classList.add('docks-image__img--hidden');this.nextElementSibling.style.display='flex';this.previousElementSibling.style.display='none'"
    />
    <div class="docks-image__placeholder" aria-hidden="true">
      <span class="docks-image__placeholder-icon">🚀</span>
    </div>
  </div>
  <div class="docks-description">
    <slot />
  </div>
</section>

<style>
  .docks-entry {
    margin: var(--space-8) 0;
    border-bottom: 1px solid var(--color-neutral-200);
    padding-bottom: var(--space-8);
  }
  .docks-entry:last-child {
    border-bottom: none;
  }

  .docks-category-label {
    font-size: var(--text-body-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-neutral-600);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
  }

  .docks-title {
    font-size: var(--text-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
  }

  .docks-image {
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    height: 12rem;
  }

  .docks-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.4s ease;
    position: relative;
    z-index: 2;
    display: block;
  }

  .docks-image:hover .docks-image__img {
    transform: scale(1.03);
  }

  /* ─── Blur-up skeleton ─── */
  .docks-image__skeleton {
    position: absolute;
    inset: 0;
    background: var(--color-neutral-600);
    filter: blur(12px);
    transform: scale(1.1);
    z-index: 1;
    transition: opacity 0.5s ease;
  }

  .docks-image__img--loading {
    opacity: 0;
  }

  .docks-image__img--hidden {
    display: none;
  }

  .docks-image__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-neutral-700), var(--color-neutral-800));
  }

  .docks-image__placeholder-icon {
    font-size: 2.5rem;
  }

  .docks-description {
    color: var(--color-neutral-700);
    line-height: var(--line-height-relaxed);
    font-family: var(--font-body);
    font-size: var(--text-body-md);
  }
</style>
