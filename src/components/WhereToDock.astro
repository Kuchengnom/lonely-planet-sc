---
interface Props {
  title: string
  category: 'landing-zone' | 'habitation' | 'rest-stop'
  image: string
  imageAlt: string
}

const { title, category, image, imageAlt } = Astro.props

const categoryLabels = {
  'landing-zone': '🛬 Landing Zone',
  'habitation': '🏠 Habitation',
  'rest-stop': '☕ Rest Stop'
}
---

<section class="docks-entry">
  <div class="docks-category-label">{categoryLabels[category]}</div>
  <h3 class="docks-title">{title}</h3>
  <div class="docks-image">
    <div class="docks-image__skeleton" aria-hidden="true" />
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class="docks-image__img docks-image__img--loading"
      onload="this.classList.remove('docks-image__img--loading');this.previousElementSibling.style.display='none'"
      onerror="this.classList.add('docks-image__img--hidden');this.nextElementSibling.style.display='flex';this.previousElementSibling.style.display='none'"
    />
    <div class="docks-image__placeholder" aria-hidden="true">
      <span class="docks-image__placeholder-icon">🚀</span>
    </div>
  </div>
  <div class="docks-description">
    <slot />
  </div>
</section>

<style>
  .docks-entry {
    margin: 2rem 0;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
  }
  .docks-entry:last-child {
    border-bottom: none;
  }

  .docks-category-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.75rem;
  }

  .docks-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #292424;
    margin-bottom: 1rem;
    font-family: Georgia, serif;
  }

  .docks-image {
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    overflow: hidden;
    position: relative;
    height: 12rem;
  }

  .docks-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.4s ease;
    position: relative;
    z-index: 2;
  }

  .docks-image:hover .docks-image__img {
    transform: scale(1.03);
  }

  /* ─── Blur-up skeleton ─── */
  .docks-image__skeleton {
    position: absolute;
    inset: 0;
    background: var(--color-neutral-600);
    filter: blur(12px);
    transform: scale(1.1);
    z-index: 1;
    transition: opacity 0.5s ease;
  }

  .docks-image__img--loading {
    opacity: 0;
  }

  .docks-image__img--hidden {
    display: none;
  }

  .docks-image__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-neutral-700), var(--color-neutral-800));
  }

  .docks-image__placeholder-icon {
    font-size: 2.5rem;
  }

  .docks-description {
    color: #44403c;
    line-height: 1.6;
  }
</style>
