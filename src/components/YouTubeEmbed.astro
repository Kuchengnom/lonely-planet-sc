---
/**
 * YouTubeEmbed Component
 *
 * Lazy-lightweight YouTube video embed with privacy-enhanced mode.
 * Auto-generates thumbnail and loads iframe only on user interaction.
 *
 * @param videoId - YouTube video ID (e.g., "5DSm_s4THpw")
 * @param title - Video title for accessibility
 * @param timestamp - Optional timestamp in seconds (e.g., 60)
 * @param className - Optional CSS classes for container
 */

interface Props {
  videoId: string;
  title: string;
  timestamp?: number;
  className?: string;
}

const { videoId, title, timestamp = 0, className = "" } = Astro.props;

// Calculate aspect ratio ratio (16:9 standard)
const aspectRatio = "56.25"; // 9/16 * 100

// Generate embed URL with privacy-enhanced mode
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}${timestamp > 0 ? `?start=${timestamp}` : ""}`;

// Generate thumbnail URL (high quality)
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
---

<div class={`youtube-embed-container ${className}`}>
  <div 
    class="youtube-embed-video-wrapper"
    style="padding-bottom: {aspectRatio}%"
  >
    <iframe
      src={embedUrl}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
      class="youtube-embed-iframe"
    ></iframe>
  </div>
</div>

<style>
  .youtube-embed-container {
    width: 100%;
    max-width: 100%;
    margin: 1rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .youtube-embed-video-wrapper {
    position: relative;
    height: 0;
    overflow: hidden;
  }

  .youtube-embed-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Responsive tight spacing for mobile */
  @media (max-width: 640px) {
    .youtube-embed-container {
      margin: 0.75rem 0;
      border-radius: 6px;
    }
  }
</style>
